{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: clang build project",
            "type": "process",
            "command": "/bin/zsh",
            "args": [
                "-c",
                "exec /usr/bin/clang -std=c17 -Wall -Wextra -Wpedantic -g \"$1\"/*.c -o \"$1/practice\"",
                "_",
                "${workspaceFolder}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
